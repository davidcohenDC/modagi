{
  "branches": [
    "master"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "git archive --format=zip --prefix=modagi-${nextRelease.version}/ -o modagi-${nextRelease.version}.zip HEAD"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "modagi-*.zip",
            "label": "Site + database + compose file (unzip, then `docker compose up`)"
          }
        ],
        "successComment": false,
        "failComment": false,
        "failTitle": false
      }
    ]
  ]
}
